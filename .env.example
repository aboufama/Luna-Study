# Organization choices: demo (default), codex-cli, or openai-api.
# codex-cli uses your existing `codex login` ChatGPT sign-in and plan allowance.
LUNA_ORGANIZER=demo
LUNA_CLI_MODEL=gpt-5.6-luna
# Background indexing, preparation, planning, and visual recovery.
LUNA_API_MODEL=gpt-6-luna
# Independent background grading; defaults to Terra when omitted.
LUNA_GRADING_MODEL=gpt-5.6-terra
# Main spoken tutor; omit this to inherit LUNA_API_MODEL.
LUNA_TUTOR_MODEL=gpt-5.6-terra
# Warm CLI process and text streaming for live voice; exec restores the baseline.
LUNA_VOICE_TRANSPORT=stream
# Lower values respond sooner but may split a student's natural pauses.
LUNA_VAD_SILENCE_SECONDS=0.5
# Optional parallel high-reasoning hints for subsequent turns. No continuous loop.
# Default off: the measured thinker did not improve current-turn latency.
LUNA_VOICE_PLANNER=false
# Reuse student-intent Jev to hide clearly obsolete boards before tutor generation.
# Default on; set off to restore completion-time visibility decisions.
LUNA_EARLY_BOARD_HIDE=on

# Enables ElevenLabs and, only in openai-api mode, OpenAI API billing.
# CLI organization is controlled separately by LUNA_ORGANIZER=codex-cli.
LIVE_APIS=false

# Optional: only needed for LUNA_ORGANIZER=openai-api.
OPENAI_API_KEY=

# Optional: path to your Codex executable if it is not on PATH.
# CODEX_BIN=/absolute/path/to/codex

# ElevenLabs transcribes your microphone and streams Luna's spoken replies.
# Free-plan allowances, account credits, and voice access apply.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
# Duplex live voice uses the realtime text-to-speech WebSocket.
ELEVENLABS_REALTIME_MODEL_ID=eleven_v4_turbo
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
PORT=5188
