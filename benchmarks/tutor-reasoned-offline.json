          "questionId": "de83cd51-b382-4d64-a03d-845266cc681a",
          "canonicalReply": "In an 8-by-10 two-player normal-form game, what is the maximum number of strict Nash equilibria?"
        },
        {
          "mode": "voice",
          "questionId": null,
          "canonicalReply": "Yes. Eight is the maximum because strict equilibria cannot share a row or column."
        }
      ],
      "intentDecisions": [
        {
          "text": "Ask me the queued question about the maximum number of strict Nash equilibria in an 8-by-10 game, exactly as written. Show a blank 8-row, 10-column grid. Do not fill in payoffs, mark equilibrium cells, or reveal the answer yet.",
          "requestsHelp": false,
